# Orchestrator PostgreSQL application role. Never commit the real value.
PG_APP_PASSWORD=replace-me

# Frozen NationLabs Proposal Builder service boundary.
PROPOSAL_BUILDER_URL=http://host.docker.internal:3000
PROPOSAL_BUILDER_USERNAME=orchestrator-service-account
PROPOSAL_BUILDER_PASSWORD=replace-me
PROPOSAL_BUILDER_TIMEOUT_S=120

# Orchestrator-owned deterministic quote-validation policy.
QUOTE_VALIDATION_MONEY_TOLERANCE=0.01
QUOTE_VALIDATION_REQUIRE_CURRENCY_DETECTED=true
QUOTE_VALIDATION_REQUIRE_STATED_TOTALS=false
QUOTE_VALIDATION_REQUIRE_VAT=false
QUOTE_VALIDATION_REQUIRED_TERMS=
